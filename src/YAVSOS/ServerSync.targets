<Project>
  <!-- Verify even cached downloads: a moved upstream tag must never silently change the binary. -->
  <Target Name="PreparePinnedServerSync" BeforeTargets="ValidateGameReferences;ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ServerSyncPath)'))" />
    <DownloadFile SourceUrl="https://github.com/blaxxun-boop/ServerSync/releases/download/v1.20/ServerSync.dll"
                  DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(ServerSyncPath)'))"
                  DestinationFileName="ServerSync.dll" Condition="!Exists('$(ServerSyncPath)')" />
    <GetFileHash Files="$(ServerSyncPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="PinnedServerSyncHash" />
    </GetFileHash>
    <Error Condition="'$(PinnedServerSyncHash)' != 'E8B61F621CC396C529D9194F202E0B22C6591DD919363A4501A579F9F7252E0E'"
           Text="ServerSync v1.20 checksum mismatch. Remove the cached DLL and retry; never use an unverified dependency." />
  </Target>
</Project>
